{
  "name": "saoirse",
  "version": "0.1.0",
  "description": "Saoirse — always-on personal AI core daemon (HTTP + WS over Engram + Herd)",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "saoirse": "./dist/client/cli.js",
    "saoirse-tui": "./dist/client/tui.js",
    "saoirse-daemon": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ tests/",
    "lint:fix": "eslint src/ tests/ --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\""
  },
  "dependencies": {
    "@mariozechner/pi-tui": "^0.73.1",
    "engram": "git+https://github.com/tom-swift-tech/engram.git#0bf16af67a700bb4e42193b09992577ad2879a83",
    "nats": "^2.29.3",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.0.0",
    "@types/ws": "^8.5.10",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.1",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.58.0",
    "vitest": "^1.4.0"
  },
  "engines": {
    "node": ">=20.0.0 <21"
  },
  "license": "Apache-2.0"
}
