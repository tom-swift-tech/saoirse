# Saoirse core daemon — environment configuration.
# Copy to .env (gitignored). No secrets belong in source.

# HTTP/WS listener port (north-facing channel contract).
PORT=8787

# Model endpoint — the base_url of any OpenAI-compatible server. The /v1 version
# segment is OPTIONAL; the gateway normalizes to /v1/chat/completions either way,
# so http://host:11434 and http://host:11434/v1 both work. Herd, Ollama,
# llama-server, vLLM, and LM Studio are interchangeable values here; Saoirse
# targets the contract, not the product. Prefer a Tailscale MagicDNS name.
MODEL_ENDPOINT=http://localhost:11434
# Model id to request from that endpoint, e.g. qwen3.6:35b-a3b.
MODEL_NAME=qwen3.6:35b-a3b
# Default max completion tokens (per-request overridable). 2048 suits a normal
# assistant; raise it for reasoning models (qwen3, etc.) — they spend tokens
# thinking before they answer, and a low cap truncates mid-thought.
MODEL_MAX_TOKENS=2048

# Auth token required on WebSocket connect. The WS listener is Tailscale-scoped;
# without this set, the push channel rejects every connection (fail closed).
# The CLI client also reads this to authenticate its push connection.
SAOIRSE_TOKEN=

# --- CLI client (the `saoirse` spoke) ---------------------------------------
# Base URL of the running daemon the CLI talks to. Prefer a Tailscale MagicDNS
# name over an IP/LAN hostname.
SAOIRSE_URL=http://localhost:8787

# Engram memory database path (SQLite). Created on first run.
ENGRAM_DB=./saoirse.engram

# How Engram embeds for recall:
#   ollama  (default) — routes embeddings through a self-hosted Ollama; boot-safe
#                       (per-message errors if unreachable, self-heals when it's up)
#   offline           — deterministic, network-free hashing; dev/offline boot only
#                       (approximate recall — works but quietly low-quality)
#   local   (OPT-IN)  — Engram's local model; pulls the deprecated @xenova/transformers
#                       chain (open advisories) and a failed download kills boot
# NOTE: ollama-mode embeddings target Engram's own embeddings URL (localhost:11434),
#       independent of MODEL_ENDPOINT above. They coincide on a single box; if your
#       Ollama is elsewhere, chat can work while embeddings silently fail.
ENGRAM_EMBEDDINGS=ollama

# --- East-west fabric (NATS) -------------------------------------------------
# NATS server on the LAN fabric (Starbase) — agents/services only; human clients
# speak HTTP/WS. Leave UNSET to stay off the fabric entirely. Prefer a Tailscale
# MagicDNS name, e.g. nats://starbase:4222.
NATS_URL=
# Subject prefix: requests arrive on <prefix>.message (request/reply, JSON).
NATS_PREFIX=saoirse

# --- Tier-1 Tool-Builder (pi) -----------------------------------------------
# Builder command, invoked non-interactively (JSON spec on stdin, JSON result on
# stdout). Leave UNSET to disable tool-building entirely (the /build route
# returns 503). The live wiring is the adapter that drives the real pi coding
# agent against MODEL_ENDPOINT:
#   PI_COMMAND=node scripts/pi-build.mjs
# (needs `npm i -g @earendil-works/pi-coding-agent` — run under Node 20).
# Contracts not products: this is a configured command, never a hardcoded
# dependency.
PI_COMMAND=
# Sandbox root for accreted (un-promoted) tool artifacts. The builder writes
# ONLY here; nothing built is live until a human approves it via the
# token-gated route.
PI_SANDBOX=./sandbox
# Ceiling on one build, ms. Agentic builds on a local model are slow; the
# adapter gives pi 540s (PI_BUILD_TIMEOUT_MS) inside this 600s outer bound.
PI_TIMEOUT_MS=600000

# --- Committed skills --------------------------------------------------------
# Base URL of a self-hosted SearXNG instance. The websearch skill reads this to
# issue searches; it is INDEPENDENT of MODEL_ENDPOINT above (a separate service,
# not the model gateway). The instance must have the JSON API enabled (Settings →
# Search → Output format → JSON, or format=json in searxng/settings.yml). Prefer
# a Tailscale MagicDNS name over a bare IP so the address survives LAN changes.
SEARXNG_URL=http://localhost:8888

# --- Skill secrets (Primitive 1) ---------------------------------------------
# Any variable prefixed SAOIRSE_SECRET_<NAME> is a skill secret. At boot the
# daemon captures every matching var into a private in-memory store and SCRUBS
# them from process.env — the live daemon process never holds the raw values
# after that point, and child processes never inherit them by accident.
#
# A skill receives a secret ONLY if its manifest declares the bare <NAME> in
# `permissions.secrets`. Example manifest entry:
#   "permissions": { "secrets": ["GITHUB_TOKEN"] }
# … causes SAOIRSE_SECRET_GITHUB_TOKEN to be injected into that skill's
# subprocess env as GITHUB_TOKEN — no other skill or process sees it.
#
# The secret COUNT and bare NAMES appear in /status for operator audit.
# Secret VALUES are never logged or surfaced anywhere. Never commit real values.
#
# Example (uncomment and fill in):
# SAOIRSE_SECRET_GITHUB_TOKEN=ghp_...

# --- Proactivity (outbound notify) ------------------------------------------
# Full ntfy topic URL the scheduler pushes to when a job fires (NTFY_URL).
# When unset, notifications are logged to the daemon console only — no external
# delivery. Prefer a Tailscale MagicDNS name so the address survives LAN
# changes (e.g. http://starbase/saoirse). Never include auth credentials here;
# use SAOIRSE_SECRET_* for any access token the ntfy server requires.
NTFY_URL=
